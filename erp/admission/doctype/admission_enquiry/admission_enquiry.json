  },
  {
   "fieldname": "staff_reference",
   "fieldtype": "Link",
   "label": "Reference Staff",
   "options": "Staff",
   "link_filters": "[[\"Staff\",\"trust\",\"=\",\"eval:doc.trust\"],[\"Staff\",\"status\",\"=\",\"Active\"]]",
   "depends_on": "eval:doc.reference=='Staff Reference'",
   "read_only_depends_on": "eval:doc.gate_pass"
  },
  {
   "fieldname": "consultancy",
   "fieldtype": "Link",
   "label": "Consultancy",
   "options": "Consultancy",
   "link_filters": "[[\"Consultancy\",\"trust\",\"=\",\"eval:doc.trust\"],[\"Consultancy\",\"status\",\"=\",\"Active\"]]",
   "depends_on": "eval:doc.reference=='Consultancy Reference'",
   "read_only_depends_on": "eval:doc.gate_pass"
  },
  {
   "fieldname": "column_break_source",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "student_reference",
   "fieldtype": "Data",
   "label": "Referring Student",
   "depends_on": "eval:doc.reference=='Student Reference'",
   "read_only_depends_on": "eval:doc.gate_pass"
  },
  {
   "fieldname": "source_details",
   "fieldtype": "Small Text",
   "label": "Reference Remarks",
