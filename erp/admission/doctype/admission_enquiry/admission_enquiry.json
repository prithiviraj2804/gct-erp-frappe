 "fields": [
  {
   "fieldname": "enquiry_section",
   "fieldtype": "Section Break",
   "label": "Enquiry"
  },
  {
   "fieldname": "id",
   "fieldtype": "Data",
   "label": "ID",
   "unique": 1,
   "read_only": 1,
   "no_copy": 1,
   "in_standard_filter": 1,
   "description": "Auto-generated UUID"
  },
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "options": "AENQ-.YYYY.-.#####",
   "default": "AENQ-.YYYY.-.#####",
   "reqd": 1,
   "hidden": 1
  },
  {
   "fieldname": "gate_pass",
   "fieldtype": "Link",
   "label": "Gate Pass",
   "options": "Admission Gate Pass",
   "no_copy": 1,
   "in_standard_filter": 1,
   "description": "The admission gate pass this enquiry was started from, if any"
  },
  {
   "fieldname": "enquiry_date",
   "fieldtype": "Date",
   "label": "Enquiry Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_enquiry",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nContacted\nVisited\nApplication Submitted\nDocuments Verified\nAdmitted\nRejected\nDropped",
   "default": "New",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Where this enquiry sits in the admission pipeline"
  },
  {
   "fieldname": "counsellor",
   "fieldtype": "Link",
   "label": "Counsellor",
   "options": "Staff",
   "link_filters": "[[\"Staff\",\"trust\",\"=\",\"eval:doc.trust\"],[\"Staff\",\"status\",\"=\",\"Active\"]]",
   "in_standard_filter": 1,
   "permlevel": 1,
   "description": "Staff member who owns this enquiry. permlevel 1: an Admission Manager assigns it; a Counsellor can see who owns a lead but cannot reassign it (or grab someone else's). Row visibility keys on this field."
  },
  {
   "fieldname": "next_follow_up",
   "fieldtype": "Date",
   "label": "Next Follow-up",
   "in_standard_filter": 1,
   "in_list_view": 1,
   "description": "When to reach the student next. Maintained from the latest Admission Follow-up once any exist."
  },
  {
   "fieldname": "application_fee_paid",
   "fieldtype": "Check",
   "label": "Application Fee Paid",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "in_standard_filter": 1,
   "in_list_view": 1,
   "description": "Set only by a submitted Fee Payment. Gates advancing to Application Submitted and beyond."
  },
  {
   "fieldname": "application_fee_payment",
   "fieldtype": "Link",
   "label": "Application Fee Payment",
   "options": "Fee Payment",
   "read_only": 1,
   "no_copy": 1,
   "description": "The receipt that collected the application fee"
  },
  {
   "fieldname": "application_fee_refunded",
   "fieldtype": "Check",
   "label": "Application Fee Refunded",
   "read_only": 1,
   "no_copy": 1,
   "in_standard_filter": 1,
   "description": "Set by a Fee Refund. The fee-paid flag is left standing — it is what happened"
  },
  {
   "fieldname": "application_fee_refund",
   "fieldtype": "Link",
   "label": "Application Fee Refund",
   "options": "Fee Refund",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "follow_up_section",
   "fieldtype": "Section Break",
   "label": "Follow-up Tracking",
