   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_outcome",
   "fieldtype": "Data",
   "label": "Last Outcome",
   "read_only": 1
  },
  {
   "fieldname": "follow_up_count",
   "fieldtype": "Int",
   "label": "Follow-up Count",
   "read_only": 1,
   "description": "How many follow-ups have been logged against this lead"
