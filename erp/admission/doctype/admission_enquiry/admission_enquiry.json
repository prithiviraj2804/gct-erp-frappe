  },
  {
   "fieldname": "follow_up_state",
   "fieldtype": "Select",
   "label": "Follow-up State",
   "options": "Never Contacted\nNo Next Step\nDue Today\nOverdue\nScheduled\nClosed",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
